# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# Database
DATABASE_URL=postgresql+asyncpg://aiops:aiops@postgres:5432/aiops_db
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis
REDIS_URL=redis://redis:6379
REDIS_DB=0
CACHE_TTL=3600
CACHE_ENABLED=true

# Milvus
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=aiops_knowledge_base
MILVUS_EMBEDDING_DIM=1536

# LLM (Claude)
ANTHROPIC_API_KEY=sk-ant-YOUR_API_KEY_HERE
LLM_MODEL=claude-3-sonnet-20240229
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=aiops-platform

# Splunk
SPLUNK_HOST=localhost
SPLUNK_PORT=8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=
SPLUNK_INDEX=main

# Datadog
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_API_URL=https://api.datadoghq.com

# Prometheus
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_QUERY_TIMEOUT=30

# ServiceNow
SERVICENOW_INSTANCE=dev12345
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

# Jira
JIRA_SERVER=https://jira.company.com
JIRA_USERNAME=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=OPS

# Notifications
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
EMAIL_SMTP_SERVER=
EMAIL_FROM=

# ML Models
ML_MODEL_PATH=./models
ISOLATION_FOREST_CONTAMINATION=0.05
LSTM_LOOKBACK_WINDOW=24
LSTM_PREDICTION_HORIZON=1
ANOMALY_DETECTION_ENABLED=true

# Incident Configuration
INCIDENT_CONFIDENCE_THRESHOLD=0.85
AUTO_REMEDIATION_P3_P4=true

# Agent Configuration
MAX_AGENT_ITERATIONS=10
AGENT_TIMEOUT=300
ENABLE_AGENT_TRACING=true

# Security
SECRET_KEY=dev-secret-key-change-in-prod
PII_REDACTION_ENABLED=true
AUDIT_LOGGING_ENABLED=true
ENABLE_RBAC=true
ENABLE_ABAC=true

# OpenTelemetry
OTEL_ENABLED=true
OTEL_EXPORTER=jaeger
JAEGER_HOST=jaeger
JAEGER_PORT=6831

# Cloud Configuration
CLOUD_PROVIDER=aws
AWS_REGION=us-east-1
GCP_PROJECT_ID=
AZURE_SUBSCRIPTION_ID=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600
