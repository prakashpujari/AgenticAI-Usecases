# ── Environment & secrets ──────────────────────────────────────────────────────
.env
*.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
build/
*.egg
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Generated pipeline outputs (job-specific PDFs, MDs, metrics) ───────────────
# Anchored to repo root so src/output/ (source code) is NOT ignored.
/output/
!/output/.gitkeep

# ── Log files ─────────────────────────────────────────────────────────────────
/logs/*.log
!/logs/.gitkeep

# ── FAISS index (binary, regenerated on each run) ─────────────────────────────
data/faiss_index/

# ── API runtime files (uploads + SQLite job database) ─────────────────────────
api/uploads/*
!api/uploads/.gitkeep
api/jobs.db

# ── Frontend build artifacts (Vercel builds from source) ──────────────────────
frontend/dist/
frontend/node_modules/

# ── Testing / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.deepeval/

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
