# ═══════════════════════════════════════════════════════════════════════════════
# .env.local Template
# ═══════════════════════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local
# 2. Replace placeholders with your actual token values
# 3. NEVER commit .env.local to git (already in .gitignore)
# 4. Load environment variables before running:
#    - PowerShell: source .env.local (via setup-env.ps1)
#    - Bash: export $(cat .env.local | xargs)
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-YOUR_NEW_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Pinecone ───────────────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk_YOUR_NEW_PINECONE_KEY_HERE
PINECONE_INDEX_NAME=mortgageindex
PINECONE_ENVIRONMENT=us-east-1
PINECONE_HOST=https://mortgageindex-96hwyzx.svc.aped-4627-b74a.pinecone.io

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Jira Cloud ─────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://mailtopprakash01.atlassian.net
JIRA_EMAIL=mailtopprakash01@gmail.com
JIRA_API_TOKEN=ATATT_YOUR_NEW_JIRA_TOKEN_HERE
JIRA_DEFAULT_PROJECT=MC

# ── LangSmith (Observability) ──────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_YOUR_NEW_LANGSMITH_KEY_HERE
LANGCHAIN_PROJECT=jira-automation-agent

# ── Groq (Optional LLM Alternative) ────────────────────────────────────────────
GROQ_API_KEY=gsk_YOUR_NEW_GROQ_KEY_HERE

# ── RBAC / Governance ──────────────────────────────────────────────────────────
ALLOWED_PROJECTS=MC,PROJ,INFRA,PLATFORM
MAX_REVIEW_ITERATIONS=2
DEDUPE_THRESHOLD=0.85

# ── Frontend (Vite) ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Deployment Tokens (Vercel & Render) ───────────────────────────────────────
VERCEL_TOKEN=vcp_YOUR_NEW_VERCEL_TOKEN_HERE
RENDER_API_KEY=rnd_YOUR_NEW_RENDER_API_KEY_HERE
