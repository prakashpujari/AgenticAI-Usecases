# Application
APP_NAME="Mortgage Utilities Platform"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false

# Security — generate with: openssl rand -hex 32
SECRET_KEY="CHANGE_ME_USE_OPENSSL_RAND_HEX_32_AT_LEAST_32_CHARS"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Database
DATABASE_URL="sqlite+aiosqlite:///./mortgage_platform.db"
# For Postgres: postgresql+asyncpg://user:password@localhost:5432/mortgage_db

# Redis
REDIS_URL="redis://localhost:6379/0"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# AI Provider: mock | openai | bedrock | azure_openai
AI_PROVIDER="mock"
OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_KEY=""
AZURE_OPENAI_DEPLOYMENT=""

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=""
LOG_LEVEL="INFO"

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60
