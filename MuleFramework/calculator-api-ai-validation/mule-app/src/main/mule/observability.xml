<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/os
        http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd">

    <!-- =========================================================== -->
    <!-- METRICS OBJECT STORE                                        -->
    <!-- Counters: request, success, failure  + latency total/count  -->
    <!-- =========================================================== -->
    <os:object-store name="metricsStore"
                     persistent="false"
                     maxEntries="1000"
                     entryTtl="86400"
                     entryTtlUnit="SECONDS"/>

    <!-- =========================================================== -->
    <!-- START-OF-REQUEST: stamps correlation ID and start timestamp -->
    <!-- =========================================================== -->
    <sub-flow name="observability-request-start">
        <ee:transform doc:name="init-trace">
            <ee:variables>
                <ee:set-variable variableName="correlationId"><![CDATA[%dw 2.0
output application/java
---
(attributes.headers.'X-Correlation-ID' default attributes.headers.'x-correlation-id' default (correlationId default uuid()))]]></ee:set-variable>
                <ee:set-variable variableName="requestStartTime"><![CDATA[%dw 2.0
output application/java
---
now() as Number {unit: "milliseconds"}]]></ee:set-variable>
                <ee:set-variable variableName="apiOperation"><![CDATA[%dw 2.0
output application/java
---
attributes.requestPath default "unknown"]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <flow-ref name="metrics-increment-request"/>
        <logger level="INFO"
                message="#['{&quot;event&quot;:&quot;api.request.start&quot;,&quot;operation&quot;:&quot;' ++ (vars.apiOperation default '') ++ '&quot;,&quot;correlationId&quot;:&quot;' ++ vars.correlationId ++ '&quot;,&quot;clientId&quot;:&quot;' ++ (attributes.headers.client_id default 'anonymous') ++ '&quot;}']"/>
    </sub-flow>

    <!-- =========================================================== -->
    <!-- END-OF-REQUEST (success)                                    -->
    <!-- =========================================================== -->
    <sub-flow name="observability-request-success">
        <flow-ref name="metrics-increment-success"/>
        <flow-ref name="metrics-record-latency"/>
        <logger level="INFO"
                message="#['{&quot;event&quot;:&quot;api.request.success&quot;,&quot;operation&quot;:&quot;' ++ (vars.apiOperation default '') ++ '&quot;,&quot;correlationId&quot;:&quot;' ++ (vars.correlationId default '') ++ '&quot;,&quot;latencyMs&quot;:' ++ ((vars.requestLatencyMs default 0) as String) ++ '}']"/>
    </sub-flow>

    <!-- =========================================================== -->
    <!-- END-OF-REQUEST (failure)                                    -->
    <!-- =========================================================== -->
    <sub-flow name="observability-record-failure">
        <flow-ref name="metrics-increment-failure"/>
        <flow-ref name="metrics-record-latency"/>
        <logger level="ERROR"
                message="#['{&quot;event&quot;:&quot;api.request.failure&quot;,&quot;operation&quot;:&quot;' ++ (vars.apiOperation default '') ++ '&quot;,&quot;errorCode&quot;:&quot;' ++ (vars.errorCode default 'UNKNOWN') ++ '&quot;,&quot;message&quot;:&quot;' ++ (vars.errorMessage default '') ++ '&quot;,&quot;correlationId&quot;:&quot;' ++ (vars.correlationId default '') ++ '&quot;,&quot;latencyMs&quot;:' ++ ((vars.requestLatencyMs default 0) as String) ++ '}']"/>
    </sub-flow>

    <!-- Internal record-success used by impl flows -->
    <sub-flow name="observability-record-success">
        <flow-ref name="metrics-increment-success"/>
        <flow-ref name="metrics-record-latency"/>
    </sub-flow>

    <!-- =========================================================== -->
    <!-- METRIC COUNTERS                                              -->
    <!-- =========================================================== -->
    <sub-flow name="metrics-increment-request">
        <try>
            <os:retrieve key="counter.request" objectStore="metricsStore">
                <os:default-value>#[0]</os:default-value>
            </os:retrieve>
            <os:store key="counter.request" objectStore="metricsStore">
                <os:value>#[(payload default 0) + 1]</os:value>
            </os:store>
            <error-handler>
                <on-error-continue type="ANY"/>
            </error-handler>
        </try>
    </sub-flow>

    <sub-flow name="metrics-increment-success">
        <try>
            <os:retrieve key="counter.success" objectStore="metricsStore">
                <os:default-value>#[0]</os:default-value>
            </os:retrieve>
            <os:store key="counter.success" objectStore="metricsStore">
                <os:value>#[(payload default 0) + 1]</os:value>
            </os:store>
            <error-handler>
                <on-error-continue type="ANY"/>
            </error-handler>
        </try>
    </sub-flow>

    <sub-flow name="metrics-increment-failure">
        <try>
            <os:retrieve key="counter.failure" objectStore="metricsStore">
                <os:default-value>#[0]</os:default-value>
            </os:retrieve>
            <os:store key="counter.failure" objectStore="metricsStore">
                <os:value>#[(payload default 0) + 1]</os:value>
            </os:store>
            <error-handler>
                <on-error-continue type="ANY"/>
            </error-handler>
        </try>
    </sub-flow>

    <sub-flow name="metrics-record-latency">
        <ee:transform>
            <ee:variables>
                <ee:set-variable variableName="requestLatencyMs"><![CDATA[%dw 2.0
output application/java
---
(now() as Number {unit: "milliseconds"}) - (vars.requestStartTime default (now() as Number {unit: "milliseconds"}))]]></ee:set-variable>
            </ee:variables>
        </ee:transform>
        <try>
            <os:retrieve key="latency.total" objectStore="metricsStore">
                <os:default-value>#[0]</os:default-value>
            </os:retrieve>
            <os:store key="latency.total" objectStore="metricsStore">
                <os:value>#[(payload default 0) + (vars.requestLatencyMs default 0)]</os:value>
            </os:store>
            <os:retrieve key="latency.count" objectStore="metricsStore">
                <os:default-value>#[0]</os:default-value>
            </os:retrieve>
            <os:store key="latency.count" objectStore="metricsStore">
                <os:value>#[(payload default 0) + 1]</os:value>
            </os:store>
            <error-handler>
                <on-error-continue type="ANY"/>
            </error-handler>
        </try>
    </sub-flow>

</mule>
