GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
APP_ENV=dev
LOG_LEVEL=INFO
MUNIT_REPORTS_DIR=./sample_reports
